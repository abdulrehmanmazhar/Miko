# Microsoft Store / MSIX identity
# Copy to .env and fill with Partner Center values.

MSIX_IDENTITY_NAME=FiggoLabs.Todo
MSIX_PUBLISHER=CN=00000000-0000-0000-0000-000000000000
MSIX_PUBLISHER_DISPLAY_NAME=Figgo Labs
MSIX_DISPLAY_NAME=Todo
MSIX_DESCRIPTION=A sophisticated todo application.
MSIX_VERSION=1.0.0.0

# Package binary (from apps/neutralino/dist/todo after neu build)
MSIX_EXECUTABLE=todo-win_x64.exe
MSIX_ARCHITECTURE=x64
MSIX_MIN_VERSION=10.0.17763.0
MSIX_MAX_VERSION_TESTED=10.0.22621.0

# Optional: override logo used for Store/tile assets
# MSIX_ICON_PATH=apps/neutralino/resources/icons/appIcon.png

# Optional: sign the produced MSIX (requires Windows SDK SignTool)
# MSIX_CERTIFICATE_PATH=C:\path\to\certificate.pfx
# MSIX_CERTIFICATE_PASSWORD=
